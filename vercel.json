{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "volley-kappa.vercel.app"
        }
      ],
      "destination": "https://spikerally.buzz/:path*",
      "permanent": true
    },
    {
      "source": "/:page(about|how-to-play|privacy|terms|contact).html",
      "destination": "/:page",
      "permanent": true
    },
    {
      "source": "/guides/index.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/:slug([a-z0-9-]+).html",
      "destination": "/guides/:slug",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/volleyball/Volleyball V1/index.html"
    },
    {
      "source": "/:page(about|how-to-play|privacy|terms|contact)",
      "destination": "/volleyball/Volleyball V1/:page.html"
    },
    {
      "source": "/guides",
      "destination": "/volleyball/Volleyball V1/guides/index.html"
    },
    {
      "source": "/guides/:slug([a-z0-9-]+)",
      "destination": "/volleyball/Volleyball V1/guides/:slug.html"
    },
    {
      "source": "/:path((?!volleyball/Volleyball V1/|api/).*)",
      "destination": "/volleyball/Volleyball V1/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(icons|img|screenshots)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/js/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
