<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the saved game (stars, unlocks, career) moves with the player's own
     Google backup and device-to-device transfer. Nothing is sent to the developer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
